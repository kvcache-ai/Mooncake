+std::pair<uint64_t, uint64_t> TEBenchRunner::experimentalControlAddresses(
+    uint64_t local_addr, uint64_t target_addr, uint64_t target_id) const {
+    CHECK_EQ(XferBenchConfig::seg_type, "DRAM");
+    CHECK_EQ(XferBenchConfig::total_buffer_size, 8589934592ull);
+    CHECK_EQ(pinned_buffer_list_.size(), 2u);
+    CHECK_EQ(target_infos_.size(), 1u);
+    CHECK_EQ(target_handles_[0], target_id);
+    CHECK_GE(experimental_thread_nic_hint, 0);
+    CHECK_LT(experimental_thread_nic_hint, 8);
+    // nic_hint is an index in the discovered HCA list, not mlx5_N's N.
+    // Buffer placement is based on the submission thread, independent of it.
+    CHECK_GE(experimental_submission_thread_id, 0);
+    CHECK_LT(experimental_submission_thread_id, 8);
+    CHECK_EQ(current_task_.size(), 8u);
+    const uint64_t active_bytes = 1073741824ull;
+    const uint64_t node = experimental_submission_thread_id % 2;
+    const uint64_t rank = experimental_submission_thread_id / 2;
+    const uint64_t nic = node * 4 + rank;
+    const uint64_t local_base = reinterpret_cast<uint64_t>(pinned_buffer_list_[node]);
+    CHECK_EQ(local_addr, local_base + rank * active_bytes);
+    const auto& info = target_infos_[0];
+    CHECK_EQ(info->buffers.size(), 2u);
+    const auto& target = info->buffers[node];
+    CHECK_EQ(target.length, XferBenchConfig::total_buffer_size);
+    CHECK_EQ(target_addr, target.addr + rank * active_bytes);
+    return {local_base + XferBenchConfig::total_buffer_size - 131072 + nic * 4096,
+            target.addr + target.length - 131072 + nic * 64};
+}

