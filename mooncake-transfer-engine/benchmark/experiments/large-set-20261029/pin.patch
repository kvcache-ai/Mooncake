+    CHECK_GE(cpu, 0); CHECK_LT(cpu, CPU_SETSIZE);
+    cpu_set_t allowed, selected;
+    CHECK_EQ(sched_getaffinity(0, sizeof(allowed), &allowed), 0);
+    CHECK(CPU_ISSET(cpu, &allowed)) << "Requested CPU outside inherited NUMA budget";
+    CPU_ZERO(&selected); CPU_SET(cpu, &selected);
+    CHECK_EQ(sched_setaffinity(0, sizeof(selected), &selected), 0);
+    LOG(INFO) << "Experimental CPU pin " << env_name << " index=" << index << " cpu=" << cpu;
