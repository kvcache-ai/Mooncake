**/.dockerignore
**/*.Dockerfile

# Keep Git metadata for submodule initialization and source version detection.
**/.git/logs
**/.git/index.lock
**/.git/FETCH_HEAD
**/.git/ORIG_HEAD

# Exclude local build products, test output, and Python caches.
**/build
**/build-*
**/cmake-build-*
**/dist
**/*.egg-info
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/*.pyc
**/*.pyo
**/*.log

# Carry verified YLT archives into the image, but not benchmark output or other
# host caches. Partial downloads are excluded as well.
.cache/*
!.cache/yalantinglibs
.cache/yalantinglibs/*
!.cache/yalantinglibs/*.tar.gz
